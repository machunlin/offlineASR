<service>
  <id>offline-asr</id>
  <name>Offline ASR</name>
  <description>本机离线中文语音识别服务</description>
  <executable>cmd.exe</executable>
  <arguments>/d /c "%BASE%\windows-start.bat"</arguments>
  <workingdirectory>%BASE%\..</workingdirectory>
  <env name="ASR_MODEL_DIR" value="%BASE%\..\models\SenseVoiceSmall" />
  <env name="ASR_SHERPA_NATIVE_PATH" value="%BASE%\..\external\sherpa-onnx-native" />
  <log mode="roll-by-size-time">
    <sizeThreshold>10485760</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <keepFiles>14</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="none" />
</service>
