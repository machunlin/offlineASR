<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>
    <groupId>com.example</groupId>
    <artifactId>offline-asr</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>offline-asr</name>
    <description>完全离线的中文语音转文字服务</description>
    <properties>
        <java.version>11</java.version>
        <maven.compiler.release>11</maven.compiler.release>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.k2fsa.sherpa.onnx</groupId>
            <artifactId>sherpa-onnx-jvm</artifactId>
            <version>2.0.3</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/lib/sherpa-onnx-jvm-2.0.3.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions><exclusion><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-logging</artifactId></exclusion></exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <exclusions><exclusion><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-logging</artifactId></exclusion></exclusions>
        </dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-log4j2</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>macos-arm64</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <dependencies>
                <dependency>
                    <groupId>com.k2fsa.sherpa.onnx</groupId>
                    <artifactId>sherpa-onnx-native-lib-osx-aarch64</artifactId>
                    <version>2.0.3</version>
                    <scope>system</scope>
                    <systemPath>${project.basedir}/lib/sherpa-onnx-native-lib-osx-aarch64-2.0.3.jar</systemPath>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>linux-x64</id>
            <dependencies>
                <dependency>
                    <groupId>com.k2fsa.sherpa.onnx</groupId>
                    <artifactId>sherpa-onnx-native-lib-linux-x64</artifactId>
                    <version>2.0.3</version>
                    <scope>system</scope>
                    <systemPath>${project.basedir}/lib/sherpa-onnx-native-lib-linux-x64-2.0.3.jar</systemPath>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>windows-x64</id>
            <dependencies>
                <dependency>
                    <groupId>com.k2fsa.sherpa.onnx</groupId>
                    <artifactId>sherpa-onnx-native-lib-win-x64</artifactId>
                    <version>2.0.3</version>
                    <scope>system</scope>
                    <systemPath>${project.basedir}/lib/sherpa-onnx-native-lib-win-x64-2.0.3.jar</systemPath>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration><includeSystemScope>true</includeSystemScope></configuration>
            </plugin>
        </plugins>
    </build>
</project>