[Unit]
Description=Offline ASR Service
After=network.target

[Service]
Type=simple
User=offline-asr
Group=offline-asr
WorkingDirectory=/opt/offline-asr
Environment=JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
Environment=ASR_HOST=127.0.0.1
ExecStart=/opt/offline-asr/linux-start.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
